{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "react",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://research-rag-backend.onrender.com/api/$1"
    }
  ]
}
