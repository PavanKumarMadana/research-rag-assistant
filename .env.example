# ============================================
# AI Research & Knowledge Assistant
# Environment Configuration
# ============================================

# Application
APP_NAME="AI Research & Knowledge Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development
APP_DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/research_assistant.db
DATABASE_ECHO=false

# Vector Store
VECTOR_DB_PATH=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM Configuration (Choose at least one)
# Google Gemini API (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.3
MAX_TOKENS=2048

# TensorFlow Model
MODEL_PATH=./models/document_classifier
NUM_CLASSES=8
MAX_SEQUENCE_LENGTH=512

# File Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=52428800

# CORS
CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# Search
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.25
MMR_LAMBDA=0.7
RETRIEVAL_CANDIDATE_MULTIPLIER=6
